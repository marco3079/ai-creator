# Modelo de configuração do AI Creator.
# Os valores abaixo são exemplos. O instalador (instalar.ps1 ou instalar.sh)
# cria o .env com segredos aleatórios. Se copiar este arquivo para .env à mão,
# troque POSTGRES_PASSWORD, JWT_SECRET e INTERNO_TOKEN.

# Senha do banco PostgreSQL (usuário e banco: aicreator)
POSTGRES_PASSWORD=aicreator

# Segredo que assina os logins (JWT). Use um valor longo e aleatório.
JWT_SECRET=troque-este-segredo

# Token usado pelos serviços internos (trainer e builder chamam o servidor com ele)
INTERNO_TOKEN=troque-token-interno

# E-mail da conta de administrador criada na primeira subida
ADMIN_EMAIL=admin@aicreator.local

# Senha inicial do administrador. Troque depois do primeiro acesso.
ADMIN_SENHA=trocar123

# Chave da API da Anthropic (agentes com o provedor ANTHROPIC). Deixe vazio se não usar.
ANTHROPIC_API_KEY=

# Chave da API da OpenAI (agentes com o provedor OPENAI). Deixe vazio se não usar.
OPENAI_API_KEY=

# Endereço do serviço de ajuste fino local (perfil gpu). Só altere se mudar o serviço de lugar.
# FINETUNER_URL=http://finetuner:8003

# Porta do site no computador
WEB_PORT=8080
