    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.17.6",
    "adm-zip": "0.5.16",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "zod": "4.6.7"
  }
}
